.venv/
venv/
*.egg-info/
build/
dist/

# Skill-local runtime assets.  The reusable bootstrap script downloads the
# embedding model and keeps all dependency/model caches under the skill root;
# they are deployment artifacts, never source-controlled files.
.cache/
.tools/
models/
.models/
eval/graph_detail.jsonl
.review-tmp/

# GSD local planning state and quick-task artifacts are intentionally local.
.planning/

# Python 编译缓存
__pycache__/
*.pyc

# 密钥配置（.env.example 保留作模板，.env 含真实 key 不入库）
.env

# 系统文件
.DS_Store

# 临时计划文档（修改计划的草稿，不入库）
docs/plan-*.md

# 评测运行产物（queries.jsonl / baselines.json 入库；results/detail 为每次运行产物）
eval/results.json
eval/detail.jsonl
